---
const currentPageURL = 'https://tsukie.com' + Astro.url.pathname.replace(/\.html$/, '');
---
<ul class="inline-flex">
  <li>
    <a
      class="flex justify-center items-center text-strong-accent hover:text-strong-accent/80 transition duration-150 ease-in-out"
      href={`https://x.com/intent/post?url=${currentPageURL}`}
      aria-label="X"
      data-share-platform="twitter"
      target="_blank"
      rel="nofollow noopener noreferrer"
    >
      <svg class="w-8 h-8 fill-current" viewBox="-12 -12 48 48" xmlns="http://www.w3.org/2000/svg">
        <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
      </svg>
    </a>
  </li>
  <li>
    <a
      class="flex justify-center items-center text-strong-accent hover:text-strong-accent/80 transition duration-150 ease-in-out"
      href={`https://www.facebook.com/sharer/sharer.php?u=${currentPageURL}`}
      aria-label="Facebook"
      data-share-platform="facebook"
      target="_blank"
      rel="nofollow noopener noreferrer"
    >
      <svg class="w-8 h-8 fill-current" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
        <path d="M14.023 24 14 17h-3v-3h3v-2c0-2.7 1.672-4 4.08-4 1.153 0 2.144.086 2.433.124v2.821h-1.67c-1.31 0-1.563.623-1.563 1.536V14H21l-1 3h-2.72v7h-3.257Z" />
      </svg>
    </a>
  </li>
</ul>

<script is:inline>
  document.querySelectorAll('[data-share-platform]').forEach(function(el) {
    el.addEventListener('click', function() {
      window.posthog?.capture('article_shared', {
        platform: el.dataset.sharePlatform,
        url: window.location.href
      });
    });
  });
</script>
