<div class="zb-card bg-card p-6">
 <div class="text-center mb-6">
 <h3 class="font-aspekta font-[650] mb-1">Discover the coder's life balance!</h3>
 <p class="text-sm text-muted-foreground">Subscribe for insights on coding, life experiences, and my indie journey.</p>
 </div>
 <form method="post" action="/api/subscribe" id="subscribe-form-widget">
 <div class="mb-2">
 <label class="sr-only" for="newsletter">Your email…</label>
 <input
 id="newsletter"
 name="email"
 type="email"
 class="form-input py-1 w-full"
 placeholder="Your email…"
 required
 />
 </div>
 <input name="website" type="text" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
 <button class="btn-sm w-full border-transparent bg-primary text-primary-foreground hover:bg-primary/90" type="submit">
 Subscribe
 </button>
 </form>
</div>
