---
import { getPagesForSidebar } from '@/lib/contentFetcher';

const { chronologically = false } = Astro.props;
const suggestedPosts = await getPagesForSidebar(3, chronologically);
---
<div class="zb-card bg-card p-6">
 <h3 class="font-aspekta font-[650] mb-2">{chronologically ? 'Latest posts' : 'Popular posts'}</h3>
 <ul class="space-y-2">
 {suggestedPosts.map((post: any) => (
 <li class="inline-flex">
 <span class="text-strong-accent mr-2">&mdash;</span>{' '}
 <a
  class="isolate font-aspekta font-[650] text-sm inline-flex relative hover:text-strong-accent duration-150 ease-out before:scale-x-0 before:origin-center before:absolute before:inset-0 before:bg-strong-accent/60 before:opacity-60 before:-z-10 before:-translate-y-1 before:-skew-y-3 hover:before:scale-x-100 before:duration-150 before:ease-in-out"
 href={`/en/${post.tag}/${post.slug}`}
 >
 {post.title}
 </a>
 </li>
 ))}
 </ul>
</div>
