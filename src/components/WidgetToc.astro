---
const { headings = [] } = Astro.props;
const minDepth = Math.min(...headings.map((h: { depth: number }) => h.depth));
const topLevel = headings.filter(
 (h: { depth: number }) => h.depth === minDepth,
);
---

{
 topLevel.length > 0 && (
 <div class="night-card bg-card p-6">
 <h3 class="font-aspekta font-[650] mb-2">Table of contents</h3>
 <ul class="space-y-2">
 {topLevel.map((h: { depth: number; slug: string; text: string }) => (
 <li class="flex items-start">
 <span class="text-strong-accent mr-2">&mdash;</span>{' '}
 <a
  class="font-aspekta font-[650] text-sm inline-flex relative hover:text-strong-accent duration-150 ease-out"
 href={`#${h.slug}`}
 >
 {h.text}
 </a>
 </li>
 ))}
 </ul>
 </div>
 )
}
