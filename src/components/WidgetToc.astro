---
const { headings = [] } = Astro.props;
const minDepth = Math.min(...headings.map((h: { depth: number }) => h.depth));
const topLevel = headings.filter(
 (h: { depth: number }) => h.depth === minDepth,
);
---

{
 topLevel.length > 0 && (
 <div class="rounded-lg border border-border p-6">
 <h3 class="font-aspekta font-[650] mb-2">Table of contents</h3>
 <ul class="space-y-2">
 {topLevel.map((h: { depth: number; slug: string; text: string }) => (
 <li class="flex items-start">
 <span class="text-strong-accent mr-2">&mdash;</span>{' '}
 <a
 class="font-aspekta font-[650] text-sm inline-flex relative hover:text-strong-accent duration-150 ease-out before:scale-x-0 before:origin-center before:absolute before:inset-0 before:bg-strong-accent/30 before:opacity-30 before:-z-10 before:translate-y-1/4 hover:before:scale-100 before:duration-150 before:ease-in-out"
 href={`#${h.slug}`}
 >
 {h.text}
 </a>
 </li>
 ))}
 </ul>
 </div>
 )
}
