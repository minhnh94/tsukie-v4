        <FooterIcon href="https://www.linkedin.com/in/minhnh94" label="linkedin" tooltip="My LinkedIn">
          <svg class="w-8 h-8 fill-current" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.5 13h-3v10h3V13ZM10 8a1.75 1.75 0 1 0 0 3.5A1.75 1.75 0 0 0 10 8Zm13.5 15v-5.7c0-3-1.6-4.5-3.8-4.5a3.3 3.3 0 0 0-2.9 1.6V13h-2.9v10h3v-5c0-1.4.6-2.4 1.9-2.4 1.3 0 1.8 1 1.8 2.4v5h2.9Z" />
