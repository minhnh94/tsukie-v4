        <!-- Copyright -->
        <p>Copyright &copy; Minh Hoang Nguyen@tsukie. All rights reserved.</p>
        <!-- Privacy policy -->
        <a href="/privacy-policy" class="text-strong-accent">Privacy Policy</a>
        <a href="https://uptime.tsukie.com" class="text-strong-accent" target="_blank" rel="noopener noreferrer">System Uptime</a>
