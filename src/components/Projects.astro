---
import ProjectCard from '@/components/ProjectCard.astro';
---
<section>
  <h2 class="font-aspekta text-xl font-[650] mb-4">Portfolio</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <ProjectCard
      pjName="WallCal"
      pjDesc="Calendar on your macOS desktop. 100k+ downloads, 4k+ monthly users, $10k+ first-year revenue."
      pjImg="https://wallcal.app/my-assets/app-icon.png"
      pjLink="https://wallcal.app/"
      bgImg="wallcal-screenshot.webp"
    />
    <ProjectCard
      pjName="Yappiely"
      pjDesc="Comments for any website, added with one script tag. Live on tsukie and WallCal."
      pjImg="yappiely-icon.png"
      pjLink="https://yappiely.com"
      bgImg="yappiely-screenshot.png"
    />
    <ProjectCard
      pjName="Endless Defense"
      pjDesc="Web-based tower defense game."
      pjImg="endless-defense-icon.png"
      pjLink="/projects/endless-defense"
      bgImg="endless-defense-bg.jpg"
    />
  </div>
</section>
