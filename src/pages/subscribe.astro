---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Screen from '@/components/Screen.astro';
import SideNavigation from '@/components/SideNavigation.astro';
import MainContent from '@/components/MainContent.astro';
import MiddleArea from '@/components/MiddleArea.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import WidgetSponsor from '@/components/WidgetSponsor.astro';
import SubscribeForm from '@/components/SubscribeForm.astro';
---

<BaseLayout
  title="tsukie - tech, soul, and dream"
  description="No spam. Signal only. Subscribe for coding tips, indie hacker notes, and growth tactics."
  ogUrl="https://tsukie.com/subscribe"
  ogType="article"
>
  <Screen>
    <SideNavigation />
    <MainContent>
      <div class="grow md:flex space-y-8 md:space-y-0 md:space-x-8 pt-12 md:pt-16 pb-16 md:pb-20">
        <MiddleArea>
          <div class="space-y-10">
            <section>
              <p
                id="subscription-result"
                class="mb-5 rounded-md border border-strong-accent/50 bg-strong-accent/10 px-4 py-3 text-sm font-medium text-strong-accent"
                role="status"
                aria-live="polite"
                hidden
              ></p>
              <h1 class="h1 font-aspekta mb-5">No spam. Signal only.</h1>
              <div class="text-muted-foreground space-y-8">
                <p class="text-lg">
                  I write about shipping code, side projects that make money, and the habits that keep you dangerous. Subscribe if you want:
                </p>
                <ul class="space-y-4">
                  <li class="flex items-start">
                    <svg class="w-3 h-3 fill-current text-strong-accent mr-3 mt-1.5 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                    </svg>
                    <span>Coding tips that actually hold up in production</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-3 h-3 fill-current text-strong-accent mr-3 mt-1.5 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                    </svg>
                    <span>Indie hacker notes from builds I shipped, not theory decks</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-3 h-3 fill-current text-strong-accent mr-3 mt-1.5 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                    </svg>
                    <span>Growth tactics that raise output without the soft-life fluff</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="w-3 h-3 fill-current text-strong-accent mr-3 mt-1.5 shrink-0" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z" />
                    </svg>
                    <span>A crew of builders chasing the same scoreboard</span>
                  </li>
                </ul>
                <p class="text-lg">Subscribe. We level up by shipping.</p>
                <div>
                  <SubscribeForm />
                </div>
              </div>
            </section>
          </div>
        </MiddleArea>
        <RightSidebar>
          <WidgetSponsor
            title="My latest project"
            pjName="WallCal"
            img="/images/wallcal-screenshot.webp"
            pjDesc="The best sticky calendar on desktop background for macOS"
            link="https://wallcal.app/"
          />
          <WidgetSponsor
            title="My latest project"
            pjName="Yappiely"
            img="/images/yappiely-screenshot.png"
            pjDesc="A lightweight comment platform to engage your readers and grow community"
            link="https://yappiely.com"
          />
        </RightSidebar>
      </div>
    </MainContent>
  </Screen>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    window.posthog?.capture('subscribe_page_viewed');

    const result = new URLSearchParams(window.location.search).get('subscription');
    const message = document.getElementById('subscription-result');
    if (!message) return;

    if (result === 'pending') {
      message.textContent = 'Check your inbox to confirm your subscription.';
      document.getElementById('subscribe-form-main')?.setAttribute('hidden', '');
    } else if (result === 'invalid-domain') {
      message.textContent = 'That email domain cannot receive email. Check the address and try again.';
    } else if (result === 'retry') {
      message.textContent = 'We could not verify that email domain right now. Please try again.';
    } else if (result === 'error') {
      message.textContent = 'Subscription failed. Please try again.';
    } else {
      return;
    }

    message.removeAttribute('hidden');
  });
</script>
</BaseLayout>
