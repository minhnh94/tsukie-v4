---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Screen from '@/components/Screen.astro';
import SideNavigation from '@/components/SideNavigation.astro';
import MainContent from '@/components/MainContent.astro';
import Highlight from '@/components/Highlight.astro';
import LighthouseScene from '@/components/LighthouseScene.astro';
import Projects from '@/components/Projects.astro';

const NAME = 'Minh Hoang Nguyen';
const EMAIL = 'minh@tsukie.com';
const LINKEDIN_URL = 'https://www.linkedin.com/in/minhnh94';
const X_URL = 'https://x.com/minhnh94';
const GITHUB_URL = 'https://github.com/minhnh94';

const profileLinks = [
  {
    label: 'LinkedIn (full history)',
    href: LINKEDIN_URL,
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'X',
    href: X_URL,
    icon: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
  {
    label: 'GitHub',
    href: GITHUB_URL,
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'Email',
    href: `mailto:${EMAIL}`,
    icon: 'M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z',
  },
];

const expertise = [
  {
    title: 'Zero to production',
    body: 'Scope with business and design, then ship MVPs to real customers.',
  },
  {
    title: 'Backend and platform',
    body: 'Scalable backend systems and the foundations that keep them secure, observable, and reliable.',
  },
  {
    title: 'AI-driven lean teams',
    body: 'Small product-engineer teams that cut vendor dependency, time to market, and cost.',
  },
  {
    title: 'Full-stack and native',
    body: 'Web and native apps, from the interface down to the infrastructure.',
  },
];

// Day-job entries stay free of company names and metrics; LinkedIn holds the details.
const selectedWork = [
  'Led a small team taking a B2B construction product from zero to production.',
  'Proposed moving a proof of concept from VBA to JavaScript, which sharply shortened the path to MVP.',
  'Led an online newspaper platform that let B2B customers manage their own content, cutting internal workload.',
  'Built auth, user services, and cross-service traceability for a microservices social platform.',
  'Connected point-card POS data to a coupon platform, so scans trigger rewards automatically.',
  'Built live rankings and PvP APIs for a social game, raising engagement and the paying-user ratio.',
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: NAME,
  url: 'https://tsukie.com',
  jobTitle: 'Software engineer',
  sameAs: [LINKEDIN_URL, X_URL, GITHUB_URL],
};
---

<BaseLayout
  title={`${NAME} - software engineer and indie maker`}
  description="Software engineer and indie maker in Tokyo, building software professionally since 2017 across startups, large enterprises, and my own products."
  ogUrl="https://tsukie.com"
  ogType="website"
  jsonLd={personSchema}
>
  <Screen>
    <SideNavigation />
    <MainContent>
      <div class="grow space-y-12 pt-4 pb-16 md:pb-20">
        <section class="night-card bg-card">
          <LighthouseScene />
          <div class="relative z-10 md:max-w-[56%] px-5 pt-[250px] md:pt-20 pb-10 md:pb-20">
            <h1 class="h1 font-aspekta mb-5"><Highlight>{NAME}</Highlight></h1>
            <p class="text-lg text-muted-foreground mb-5">
              Software engineer and indie maker in Tokyo. Building software professionally since
              2017, across startups, large enterprises, and my own products.
            </p>
            <ul class="flex flex-wrap gap-2 -ml-2">
              {profileLinks.map(({ label, href, icon }) => (
                <li>
                  <a
                    class="block p-2 text-strong-accent hover:text-strong-accent/70 transition-colors"
                    href={href}
                    aria-label={label}
                    title={label}
                    target={href.startsWith('mailto:') ? undefined : '_blank'}
                    rel={href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  >
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d={icon} /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section>
          <h2 class="font-aspekta text-xl font-[650] mb-4">What I do</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {expertise.map(({ title, body }) => (
              <div class="night-card bg-card p-4">
                <h3 class="font-aspekta font-[650] mb-1">{title}</h3>
                <p class="text-sm text-muted-foreground">{body}</p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="font-aspekta text-xl font-[650] mb-4">Selected work</h2>
          <ul class="night-card bg-card list-disc pl-9 pr-5 py-5 space-y-2 text-muted-foreground">
            {selectedWork.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <Projects />

        <section class="night-card bg-card p-4">
          <h2 class="font-aspekta text-xl font-[650] mb-2">Got something in mind?</h2>
          <p class="text-muted-foreground">
            Let's talk: <a class="text-strong-accent hover:underline" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          </p>
          <p class="text-sm text-muted-foreground mt-3">
            Or read <a class="text-strong-accent hover:underline" href="/blog">the blog</a>.
          </p>
        </section>
      </div>
    </MainContent>
  </Screen>
</BaseLayout>
