---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Screen from '@/components/Screen.astro';
import SideNavigation from '@/components/SideNavigation.astro';
import MainContent from '@/components/MainContent.astro';
import MiddleArea from '@/components/MiddleArea.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import WidgetNewsletter from '@/components/WidgetNewsletter.astro';
import WidgetSponsor from '@/components/WidgetSponsor.astro';
import ShareBtnRow from '@/components/ShareBtnRow.astro';
---

<BaseLayout
  title="Yappie Test"
  description="Local test page for the Yappie comments widget."
  ogUrl="https://tsukie.com/yappie-test"
  ogType="article"
>
  <Screen>
    <SideNavigation />
    <MainContent>
      <div
        class="grow space-y-8 pb-16 pt-12 md:flex md:space-x-8 md:space-y-0 md:pb-20 md:pt-16"
      >
        <MiddleArea>
          <div class="mb-3">
            <a
              class="inline-flex rounded-full border border-slate-200 text-sky-500 dark:border-slate-800 dark:bg-gradient-to-t dark:from-slate-800 dark:to-slate-800/30"
              href="/"
            >
              <span class="sr-only">Back</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34">
                <path
                  class="fill-current"
                  d="m16.414 17 3.293 3.293-1.414 1.414L13.586 17l4.707-4.707 1.414 1.414z"
                ></path>
              </svg>
            </a>
          </div>

          <article>
            <header
              class="relative overflow-hidden rounded-lg border border-slate-200 p-4 dark:border-slate-800"
            >
              <div
                class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-100"
                style="background-image: url(/images/post-image.jpg)"
                aria-hidden="true"
              ></div>
              <div
                class="pointer-events-none absolute inset-0 bg-white/75 dark:bg-slate-900/75"
                aria-hidden="true"
              ></div>
              <div class="relative z-10">
                <div class="mb-1 flex items-center justify-between">
                  <div class="text-xs uppercase text-slate-500">
                    <span class="text-sky-500">&mdash;</span>
                    Test article
                  </div>
                  <ShareBtnRow />
                </div>
                <h1 class="h1 mb-4 font-aspekta">Yappie Test</h1>
                <p class="mb-3 italic text-gray-500 dark:text-gray-400">
                  Test page for comment and quote previews.
                </p>
              </div>
            </header>
            <hr class="my-4 border-t border-sky-500" />
            <div class="prose max-w-none dark:prose-invert">
              <h2>Recognizing online casino and cryptocurrency scams</h2>
              <p>
                This local test article explains how misleading promotions use promises of
                guaranteed profits to attract readers. An advertisement might say “win big
                now” or promise a hundredfold return after a deposit. Those claims are
                warning signs, not recommendations. No investment or casino can guarantee
                that every participant will make money, and urgent deadlines often pressure
                people into acting before they check the facts.
              </p>
              <p>
                Readers should verify who operates a service, examine independent evidence,
                and avoid sending money to strangers who promise effortless returns. A
                comment quoting a suspicious advertisement to criticize it can help other
                readers recognize the same tactic. Quoting harmful or misleading language
                does not automatically mean that the writer endorses it. The surrounding
                explanation and the comment being replied to matter.
              </p>
              <p>
                Discussion below welcomes questions, personal experiences, and warnings
                about these tactics. Promotional links, requests for deposits, and repeated
                unsolicited advertisements do not contribute to that discussion. Please
                describe suspicious claims without encouraging anyone to participate or
                sharing another person's private information.
              </p>
              <script
                async
                src="http://100.95.69.83:3000/embed/dfb6a318-b251-4d57-8660-92debd398792.js"
              ></script>
            </div>
          </article>
        </MiddleArea>

        <RightSidebar>
          <WidgetNewsletter />
          <WidgetSponsor
            title="My latest project"
            pjName="WallCal"
            img="/images/wallcal-screenshot.webp"
            pjDesc="The best sticky calendar on desktop background for macOS"
            link="https://wallcal.app/"
          />
          <WidgetSponsor
            title="My latest project"
            pjName="Yappiely"
            img="/images/yappiely-screenshot.png"
            pjDesc="A lightweight comment platform to engage your readers and grow community"
            link="https://yappiely.com"
          />
        </RightSidebar>
      </div>
    </MainContent>
  </Screen>
</BaseLayout>
